# Supabase Configuration (client)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Supabase Service Key (SERVER ONLY - do NOT prefix with VITE_ or expose to client)
# Example on server / Render: SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Retell AI (server)
# Server-side API key (set as RETELL_API_KEY) and client-only configs remain VITE_ if needed
RETELL_API_KEY=your_retell_api_key
VITE_RETELL_FROM_NUMBER=+14752906147
VITE_RETELL_AGENT_ID=your_retell_agent_id
# PayPal (server)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret

# Notes:
# - Do NOT include SUPABASE_SERVICE_ROLE_KEY in any client-bundled VITE_ variable. Keep it secret and set it only on the server (Render/PM2/systemd).
# - For local development you can keep client VITE_ vars in this file, but set server-only keys in your shell or in this file without the VITE_ prefix (but be careful not to commit these to git).